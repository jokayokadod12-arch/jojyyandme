rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Only the two signed-in accounts (her + him) can upload or view photos.
    match /{allPaths=**} {
      allow read, write: if request.auth != null &&
        request.auth.token.email in [
          "jojy@jojyyandme.app",
          "yoyo@jojyyandme.app"
        ];
    }
  }
}

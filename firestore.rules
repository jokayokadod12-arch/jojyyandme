rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the two signed-in accounts (her + him) can read/write anything.
    // No one else — not even other logged-in Firebase users — can touch it.
    match /{document=**} {
      allow read, write: if request.auth != null &&
        request.auth.token.email in [
          "jojy@jojyyandme.app",
          "yoyo@jojyyandme.app"
        ];
    }
  }
}
